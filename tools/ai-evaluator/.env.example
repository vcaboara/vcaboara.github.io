# AI Conversation Script - API Keys Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Google Gemini API Key (FREE tier) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-your-key-here

# Anthropic API Key (optional) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override default model per provider (env var > --model flag > built-in default)
# GEMINI_MODEL=gemini-2.0-flash-exp
# OPENAI_MODEL=gpt-4
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
